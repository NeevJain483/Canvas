{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@lib/*": [
        "./lib/*"
      ],
      "@style/*": [
        "./style/*"
      ],
      "@component/*": [
        "./component/*"
      ],
      "@ui/*": [
        "./ui/*"
      ],
      "@public/*": [
        "./public/*"
      ],
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}